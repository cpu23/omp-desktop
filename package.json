{
  "name": "omp-desktop",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/daemon.ts",
    "dev": "bun --watch run src/daemon.ts",
    "app": "tauri dev",
    "app:build": "tauri build --no-bundle",
    "app:install": "bun run app:build && bun run scripts/install-app.ts",
    "app:webkit:build": "bun run scripts/build-webkit.ts",
    "smoke": "bun run scripts/smoke.ts",
    "release:check": "bun run scripts/release-check.ts",
    "test": "bun test",
    "check": "bunx tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@xterm/headless": "^6.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bun-pty": "^0.4.11"
  }
}
