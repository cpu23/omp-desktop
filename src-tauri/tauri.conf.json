{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMP Desktop",
  "version": "0.1.0",
  "identifier": "sh.omp.desktop",
  "build": {
    "frontendDist": "./bootstrap"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OMP Desktop",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "focus": true,
        "visible": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
