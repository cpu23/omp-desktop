{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "remote-notifications",
  "description": "Allow the loopback desktop client to request and send native notifications only.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "notification:allow-register-listener"
  ]
}
